{
  "name": "deus-ex-machina",
  "version": "0.3.0",
  "description": "A minimal Pi plugin for Dexter control and product research",
  "keywords": [
    "pi-package",
    "pi-extension",
    "developer-tools",
    "research"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arkts-dev/deus.git"
  },
  "homepage": "https://github.com/arkts-dev/deus#readme",
  "bugs": "https://github.com/arkts-dev/deus/issues",
  "type": "module",
  "files": [
    "dist",
    "skills",
    "skills.lock.json",
    "prompts/kernel.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "skills:verify": "node scripts/sync-skills.mjs --verify",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "format": "prettier --write src tests scripts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json"
  },
  "pi": {
    "extensions": [
      "dist/extension.js",
      "dist/designer.js",
      "dist/board.js"
    ],
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pi-web-access": "0.29.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "25.3.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "bin": {
    "deus-mcp": "dist/mcp-cli.js"
  },
  "private": true,
  "license": "Apache-2.0"
}
